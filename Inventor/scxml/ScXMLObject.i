/* Coin's ScXML factories return new objects as void *.  Unlike SoBase,
   ScXMLObject has no ref/unref protocol, so the returned SWIG wrapper owns
   the object and releases it through the virtual destructor. */
%define PIVY_SCXML_FACTORY_OUT(_class_)
%typemap(out) void * _class_::createInstance {
  $result = autocast_scxml_object((ScXMLObject *)$1, 1);
}
%enddef

